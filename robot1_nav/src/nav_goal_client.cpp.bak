#include <functional>
#include <memory>
#include <string>

#include "rclcpp/rclcpp.hpp"
#include "rclcpp_action/rclcpp_action.hpp"

#include "geometry_msgs/msg/pose_stamped.hpp"
#include "nav2_msgs/action/navigate_to_pose.hpp"


class NavGoalClient : public rclcpp::Node
{
public:
    using NavigateToPose =
        nav2_msgs::action::NavigateToPose;

    using GoalHandleNavigateToPose =
        rclcpp_action::ClientGoalHandle<NavigateToPose>;


    NavGoalClient()
    : Node("nav_goal_client"),
      goal_active_(false),
      feedback_count_(0)
    {
        // =====================================================
        // Nav2 NavigateToPose Action Client
        // =====================================================
        action_client_ =
            rclcpp_action::create_client<NavigateToPose>(
                this,
                "/navigate_to_pose"
            );


        // =====================================================
        // Destination Pose Subscriber
        // =====================================================
        destination_sub_ =
            this->create_subscription<
                geometry_msgs::msg::PoseStamped
            >(
                "/destination_pose",
                10,

                std::bind(
                    &NavGoalClient::destination_callback,
                    this,
                    std::placeholders::_1
                )
            );


        RCLCPP_INFO(
            this->get_logger(),
            "Nav Goal Client started"
        );

        RCLCPP_INFO(
            this->get_logger(),
            "Subscribe : /destination_pose"
        );

        RCLCPP_INFO(
            this->get_logger(),
            "Action    : /navigate_to_pose"
        );
    }


private:

    // =========================================================
    // /destination_pose callback
    // =========================================================
    void destination_callback(
        const geometry_msgs::msg::PoseStamped::SharedPtr msg
    )
    {
        // -----------------------------------------------------
        // 현재 이미 Navigation 수행 중
        //
        // 1차 버전에서는 새로운 목적지를 무시.
        // 나중에 cancel -> new goal 기능 추가 예정.
        // -----------------------------------------------------
        if (goal_active_)
        {
            RCLCPP_WARN(
                this->get_logger(),
                "Navigation already active. "
                "New destination ignored."
            );

            return;
        }


        // -----------------------------------------------------
        // frame_id 확인
        // -----------------------------------------------------
        if (msg->header.frame_id.empty())
        {
            RCLCPP_ERROR(
                this->get_logger(),
                "Destination pose has empty frame_id"
            );

            return;
        }


        RCLCPP_INFO(
            this->get_logger(),
            "Destination received: "
            "frame=%s, x=%.3f, y=%.3f",
            msg->header.frame_id.c_str(),
            msg->pose.position.x,
            msg->pose.position.y
        );


        // -----------------------------------------------------
        // Nav2 Action Server 확인
        // -----------------------------------------------------
        if (
            !action_client_->wait_for_action_server(
                std::chrono::seconds(2)
            )
        )
        {
            RCLCPP_ERROR(
                this->get_logger(),
                "/navigate_to_pose action server "
                "is not available"
            );

            return;
        }


        // -----------------------------------------------------
        // NavigateToPose Goal 생성
        // -----------------------------------------------------
        NavigateToPose::Goal goal_msg;

        goal_msg.pose = *msg;


        // 빈 문자열이면 별도 BT 파일을 지정하지 않음
        goal_msg.behavior_tree = "";


        RCLCPP_INFO(
            this->get_logger(),
            "Sending Nav2 goal: "
            "x=%.3f, y=%.3f",
            goal_msg.pose.pose.position.x,
            goal_msg.pose.pose.position.y
        );


        // -----------------------------------------------------
        // Action Callback 설정
        // -----------------------------------------------------
        auto send_goal_options =
            rclcpp_action::Client<
                NavigateToPose
            >::SendGoalOptions();


        send_goal_options.goal_response_callback =
            std::bind(
                &NavGoalClient::goal_response_callback,
                this,
                std::placeholders::_1
            );


        send_goal_options.feedback_callback =
            std::bind(
                &NavGoalClient::feedback_callback,
                this,
                std::placeholders::_1,
                std::placeholders::_2
            );


        send_goal_options.result_callback =
            std::bind(
                &NavGoalClient::result_callback,
                this,
                std::placeholders::_1
            );


        // -----------------------------------------------------
        // Goal 전송
        // -----------------------------------------------------
        action_client_->async_send_goal(
            goal_msg,
            send_goal_options
        );


        /*
         * 여기서는 아직 goal_active_ = true 하지 않음.
         *
         * Nav2 Action Server가 실제 Goal을 ACCEPT 해야
         * goal_response_callback()에서 true로 변경.
         */
    }


    // =========================================================
    // Goal accepted / rejected callback
    // =========================================================
    void goal_response_callback(
        GoalHandleNavigateToPose::SharedPtr goal_handle
    )
    {
        if (!goal_handle)
        {
            RCLCPP_ERROR(
                this->get_logger(),
                "Nav2 goal REJECTED"
            );

            goal_active_ = false;

            return;
        }


        current_goal_handle_ =
            goal_handle;

        goal_active_ = true;

        feedback_count_ = 0;


        RCLCPP_INFO(
            this->get_logger(),
            "Nav2 goal ACCEPTED"
        );
    }


    // =========================================================
    // Navigation feedback
    // =========================================================
    void feedback_callback(
        GoalHandleNavigateToPose::SharedPtr,
        const std::shared_ptr<
            const NavigateToPose::Feedback
        > feedback
    )
    {
        /*
         * Nav2 feedback가 자주 들어오기 때문에
         * 매번 출력하면 로그가 너무 많아짐.
         *
         * 10번에 한 번씩 출력.
         */
        feedback_count_++;


        if ((feedback_count_ % 10) != 0)
        {
            return;
        }


        RCLCPP_INFO(
            this->get_logger(),
            "Navigating... "
            "distance_remaining=%.2f m, "
            "recoveries=%d",
            feedback->distance_remaining,
            feedback->number_of_recoveries
        );
    }


    // =========================================================
    // Navigation result callback
    // =========================================================
    void result_callback(
        const GoalHandleNavigateToPose::WrappedResult & result
    )
    {
        goal_active_ = false;

        current_goal_handle_.reset();


        switch (result.code)
        {
            // -------------------------------------------------
            // 도착 성공
            // -------------------------------------------------
            case rclcpp_action::ResultCode::SUCCEEDED:

                RCLCPP_INFO(
                    this->get_logger(),
                    "================================"
                );

                RCLCPP_INFO(
                    this->get_logger(),
                    "NAVIGATION SUCCEEDED"
                );

                RCLCPP_INFO(
                    this->get_logger(),
                    "Destination reached"
                );

                RCLCPP_INFO(
                    this->get_logger(),
                    "================================"
                );

                break;


            // -------------------------------------------------
            // Nav2에서 실패 처리
            // -------------------------------------------------
            case rclcpp_action::ResultCode::ABORTED:

                RCLCPP_ERROR(
                    this->get_logger(),
                    "NAVIGATION ABORTED"
                );

                break;


            // -------------------------------------------------
            // Goal 취소
            // -------------------------------------------------
            case rclcpp_action::ResultCode::CANCELED:

                RCLCPP_WARN(
                    this->get_logger(),
                    "NAVIGATION CANCELED"
                );

                break;


            // -------------------------------------------------
            // 알 수 없는 결과
            // -------------------------------------------------
            default:

                RCLCPP_ERROR(
                    this->get_logger(),
                    "Unknown navigation result"
                );

                break;
        }
    }


    // =========================================================
    // ROS interfaces
    // =========================================================
    rclcpp::Subscription<
        geometry_msgs::msg::PoseStamped
    >::SharedPtr destination_sub_;


    rclcpp_action::Client<
        NavigateToPose
    >::SharedPtr action_client_;


    GoalHandleNavigateToPose::SharedPtr
        current_goal_handle_;


    // =========================================================
    // State
    // =========================================================
    bool goal_active_;

    unsigned int feedback_count_;
};


// =============================================================
// MAIN
// =============================================================
int main(int argc, char * argv[])
{
    rclcpp::init(argc, argv);

    auto node =
        std::make_shared<NavGoalClient>();

    rclcpp::spin(node);

    rclcpp::shutdown();

    return 0;
}
